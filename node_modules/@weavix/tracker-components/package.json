{
  "name": "@weavix/tracker-components",
  "version": "0.1.4",
  "description": "Shared UI components for Yandex Tracker plugins",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "require": "./build/cjs/index.js",
      "import": "./build/esm/index.js"
    },
    "./build/*": "./build/*",
    "./styles/*": "./styles/*"
  },
  "files": [
    "build",
    "styles"
  ],
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "author": "Tracker Team <tracker-plugins-dev@yandex-team.ru>",
  "license": "UNLICENSED",
  "repository": {
    "type": "arc",
    "url": "https://a.yandex-team.ru/arcadia/data-ui/tracker-plugin-components"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "pnpm": "10.17.1",
    "node": ">= 20.0.0",
    "yarn": "Please use pnpm instead of yarn to install dependencies",
    "npm": "Please use pnpm instead of npm to install dependencies"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@bem-react/classname": "^1.6.0",
    "@gravity-ui/illustrations": "^2.1.0",
    "@gravity-ui/sdk": "1.6.0",
    "@weavix/tracker-api-types": "0.0.3",
    "bem-cn-lite": "^4.1.0",
    "core-js": "^3.38.0",
    "lodash": "^4.17.22",
    "lodash-es": "^4.17.22",
    "react-use": "17.4.0"
  },
  "peerDependencies": {
    "@gravity-ui/icons": "^2.14.0",
    "@gravity-ui/uikit": "^7.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@gravity-ui/app-builder": "0.38.0",
    "@gravity-ui/eslint-config": "4.2.0",
    "@gravity-ui/icons": "2.17.0",
    "@gravity-ui/prettier-config": "1.1.0",
    "@gravity-ui/stylelint-config": "4.0.1",
    "@gravity-ui/tsconfig": "1.0.0",
    "@gravity-ui/uikit": "7.33.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@storybook/test": "8.6.14",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.14.170",
    "@types/minimatch": "5.1.2",
    "@types/node": "24.7.2",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "babel-jest": "29.7.0",
    "babel-loader": "9.1.3",
    "css-loader": "^7.1.4",
    "eslint": "9.39.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.7.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sass": "1.77.8",
    "sass-loader": "^16.0.7",
    "storybook": "8.6.14",
    "storybook-addon-mock": "5.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "15.11.0",
    "ts-jest": "29.3.0",
    "typescript": "5.8.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "app-builder build --config ./app-builder.config.ts",
    "postbuild": "node scripts/copy-readmes.mjs",
    "build:compile": "tsc -p tsconfig.publish.json",
    "build:storybook": "storybook build -c .storybook -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.publish.json",
    "test": "jest",
    "lint:js": "eslint src",
    "lint:js:fix": "eslint src --fix",
    "lint:styles": "stylelint 'src/**/*.scss'",
    "lint:styles:fix": "stylelint 'src/**/*.scss' --fix",
    "lint:prettier": "prettier --check '**/*.{js,ts,tsx,scss}'",
    "lint": "npm-run-all --parallel lint:*",
    "storybook": "storybook dev -p 7008",
    "ci:storybook:build": "pnpm run build:storybook"
  }
}